<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SquadEditor</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Lang\*.json" />
    <EmbeddedResource Include="Lang\*.json" LogicalName="SquadEditor.App.Lang.%(Filename).json" />
    <ApplicationDefinition Remove="SquadEditor.App\App.xaml" />
    <ApplicationDefinition Include="SquadEditor.App\App.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="app.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SquadEditor.Core\SquadEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\layouts\*.json" LogicalName="SquadEditor.App.Layouts.%(Filename).json" />
  </ItemGroup>
</Project>